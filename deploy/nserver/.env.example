# cal-quickadd container env. Copy to deploy/mserver/.env and fill in.

# --- Required ---
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CALENDAR_ID=your-email@gmail.com

# --- Gemini model selection ---
# Primary model. Falls back to GEMINI_MODEL_FALLBACK on hard quota 429.
# gemini-2.0-flash shuts down 2026-06-01; 2.5-flash is the current free-tier workhorse,
# 2.5-flash-lite is the cheaper fallback (separate quota bucket).
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite

# --- OAuth credential paths inside the container ---
GOOGLE_CREDENTIALS_PATH=/config/credentials.json
GOOGLE_TOKEN_PATH=/config/token.json

# --- Family-member calendar routing ---
FAMILY_MEMBERS=jimi,tricia,nic,soph,jonnie,dad
FAMILY_CALENDARS={}

# --- Misc ---
TIMEZONE=America/Edmonton

# --- Optional shared-secret check on POST endpoints ---
# Leave blank to disable. If set, the TUI must send X-Cal-Token: <value>.
CAL_TOKEN=
